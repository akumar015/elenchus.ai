# Google Gemini API Key
GOOGLE_API_KEY=your_google_api_key_here

# Gnani / Vachana Speech Services (STT & TTS)
GNANI_API_BASE_URL=https://api.vachana.ai
GNANI_API_KEY=your_gnani_api_key_here
GNANI_PRISMA_STT_ENDPOINT=https://api.vachana.ai/api/v1/stt/transcribe
GNANI_PRISMA_STT_WS_ENDPOINT=wss://api.vachana.ai/api/v1/stt/stream
GNANI_TIMBRE_TTS_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
GNANI_TIMBRE_TTS_SSE_ENDPOINT=https://api.vachana.ai/api/v1/tts/stream
GNANI_TIMBRE_TTS_WS_ENDPOINT=wss://api.vachana.ai/api/v1/tts/ws
